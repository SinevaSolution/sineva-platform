{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@sineva/i18n": [
        "../../packages/i18n/index.ts"
      ],
      "@sineva/card-schemas": [
        "../../packages/card-schemas/src/index.ts"
      ],
      "@sineva/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@sineva/ui/cards": [
        "../../packages/ui/src/cards/index.ts"
      ],
      "@sineva/ui/format": [
        "../../packages/ui/src/lib/format.ts"
      ],
      "@sineva/ui/theme": [
        "../../packages/ui/src/lib/theme.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
