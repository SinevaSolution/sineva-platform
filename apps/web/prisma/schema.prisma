// Database safety — read before running any Prisma command.
//
// This Postgres instance is shared with sineva-ai (Python/SQLAlchemy), which
// owns the `public` schema. Every platform model therefore lives in the
// dedicated Postgres schema `platform` (`schemas` below + `@@schema` on each
// model), and migrations created from this file only ever touch `platform`.
//
// Never run `prisma migrate reset` or `prisma db push` against a database that
// holds data you care about: both can drop objects. Use them only against a
// throwaway container (see `test:integration`). Production gets
// `prisma migrate deploy` only.

generator client {
  provider = "prisma-client"
  // The generated client is build output, not source: it is gitignored and
  // rebuilt by `npm run db:generate` (which `build` and `typecheck` run first).
  output   = "../src/server/infrastructure/database/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform"]
}

// ---------------------------------------------------------------------------
// Tenancy & Workspaces
// ---------------------------------------------------------------------------

model Workspace {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_slug  String    @unique @map("workspace_slug")
  workspace_name  String    @map("workspace_name")
  owner_user_id   String?   @map("owner_user_id") @db.Uuid
  status          String    @default("active") @map("status") // trialing | active | past_due | read_only | suspended | pending_deletion | deleted
  status_reason   String?   @map("status_reason")
  trial_ends_at   DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  timezone        String    @default("Asia/Jakarta") @map("timezone")
  default_locale  String    @default("id") @map("default_locale")
  logo_url        String?   @map("logo_url")
  deleted_at      DateTime? @map("deleted_at") @db.Timestamptz(6)
  slug_changed_at DateTime? @map("slug_changed_at") @db.Timestamptz(6)

  // Usage, Plans & Billing fields (kept untouched per WP-M0-21, moved in WP-M3-27 / WP-M4-38)
  subscription_tier       String @default("growth") @map("subscription_tier")
  monthly_token_quota     Int    @default(1000000) @map("monthly_token_quota")
  monthly_tokens_consumed Int    @default(0) @map("monthly_tokens_consumed")

  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                 User?                       @relation("WorkspaceOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  members               WorkspaceMember[]
  member_specialists    WorkspaceMemberSpecialist[]
  invitations           WorkspaceInvitation[]
  ownership_transfers   OwnershipTransfer[]
  conversations         Conversation[]
  storage_objects       StorageObject[]
  chat_runs             ChatRun[]
  message_cards         MessageCard[]
  inbox_items           InboxItem[]
  approvals             Approval[]
  input_requests        InputRequest[]
  library_folders       LibraryFolder[]
  library_documents     LibraryDocument[]
  library_scopes        LibraryDocumentScope[]
  library_folder_scopes LibraryFolderScope[]
  library_events        LibraryIngestEvent[]
  business_profile      BusinessProfile?
  business_offerings    BusinessOffering[]
  business_policies     BusinessPolicy[]
  profile_versions      BusinessProfileVersion[]
  onboarding_states     OnboardingState[]
  profile_scans         ProfileScan[]
  checklist_items       WorkspaceChecklistState[]
  workflows             Workflow[]
  workflow_versions     WorkflowVersion[]
  workflow_runs         WorkflowRun[]
  workflow_run_steps    WorkflowRunStep[]
  workflow_run_events   WorkflowRunEvent[]

  @@map("workspaces")
  @@schema("platform")
}

model WorkspaceMember {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id     String   @map("workspace_id") @db.Uuid
  user_id          String   @map("user_id") @db.Uuid
  role             String   @default("member") @map("role") // owner | admin | member | viewer
  specialist_scope String   @default("all") @map("specialist_scope") // all | selected
  job_title        String?  @map("job_title")
  department       String?  @map("department")
  created_at       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace                   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  specialists WorkspaceMemberSpecialist[]

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
  @@map("workspace_members")
  @@schema("platform")
}

model WorkspaceMemberSpecialist {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String   @map("workspace_id") @db.Uuid
  workspace_member_id String   @map("workspace_member_id") @db.Uuid
  agent_slug          String   @map("agent_slug")
  created_at          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspace_member_id], references: [id], onDelete: Cascade)

  @@unique([workspace_member_id, agent_slug])
  @@index([workspace_id])
  @@index([workspace_member_id])
  @@map("workspace_member_specialists")
  @@schema("platform")
}

model WorkspaceInvitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String    @map("workspace_id") @db.Uuid
  email             String    @map("email")
  role              String    @default("member") @map("role") // owner | admin | member | viewer
  inviter_user_id   String    @map("inviter_user_id") @db.Uuid
  token_hash        String    @unique @map("token_hash")
  specialist_scope  String    @default("all") @map("specialist_scope")
  // Allowlist of agent_slug for scope `selected` (ADR-0029); applied to
  // workspace_member_specialists on accept. Empty for scope `all`.
  scope_agent_slugs String[]  @default([]) @map("scope_agent_slugs")
  expires_at        DateTime  @map("expires_at") @db.Timestamptz(6)
  accepted_at       DateTime? @map("accepted_at") @db.Timestamptz(6)
  revoked_at        DateTime? @map("revoked_at") @db.Timestamptz(6)
  last_sent_at      DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  // Set once when an expiry was first noticed, so `invitation.expired` is audited once.
  expired_logged_at DateTime? @map("expired_logged_at") @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  inviter   User      @relation("InviterUser", fields: [inviter_user_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([email])
  @@map("workspace_invitations")
  @@schema("platform")
}

// One open row per workspace (partial unique index, raw SQL in the migration):
// the owner names an existing admin, who confirms through an emailed link.
model OwnershipTransfer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @map("workspace_id") @db.Uuid
  from_user_id String    @map("from_user_id") @db.Uuid
  to_user_id   String    @map("to_user_id") @db.Uuid
  token_hash   String    @unique @map("token_hash")
  expires_at   DateTime  @map("expires_at") @db.Timestamptz(6)
  accepted_at  DateTime? @map("accepted_at") @db.Timestamptz(6)
  cancelled_at DateTime? @map("cancelled_at") @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  from_user User      @relation("OwnershipTransferFrom", fields: [from_user_id], references: [id], onDelete: Cascade)
  to_user   User      @relation("OwnershipTransferTo", fields: [to_user_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@map("ownership_transfers")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Identity & Authentication
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String    @unique @map("email")
  email_verified         Boolean   @default(false) @map("email_verified")
  email_verified_at      DateTime? @map("email_verified_at") @db.Timestamptz(6)
  full_name              String    @map("full_name")
  preferred_name         String?   @map("preferred_name")
  salutation             String?   @map("salutation") // none | pak | bu | kak | mas | mbak
  phone_number           String?   @map("phone_number")
  phone_verified_at      DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  locale                 String    @default("id") @map("locale")
  timezone               String    @default("Asia/Jakarta") @map("timezone")
  about_me               String?   @map("about_me")
  use_profile_in_context Boolean   @default(true) @map("use_profile_in_context")
  avatar_url             String?   @map("avatar_url")
  status                 String    @default("active") @map("status") // active | suspended | pending_deletion | deleted
  two_factor_enabled     Boolean   @default(false) @map("two_factor_enabled")
  created_at             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owned_workspaces         Workspace[]           @relation("WorkspaceOwner")
  memberships              WorkspaceMember[]
  invitations_sent         WorkspaceInvitation[] @relation("InviterUser")
  ownership_transfers_from OwnershipTransfer[]   @relation("OwnershipTransferFrom")
  ownership_transfers_to   OwnershipTransfer[]   @relation("OwnershipTransferTo")
  accounts                 Account[]
  sessions                 Session[]
  staff_profile            PlatformStaff?
  conversations            Conversation[]
  preferences              UserPreferences?
  onboarding_states        OnboardingState[]

  @@map("users")
  @@schema("platform")
}

model UserPreferences {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @unique @map("user_id") @db.Uuid
  theme             String   @default("system") @map("theme") // light | dark | system
  density           String   @default("comfortable") @map("density") // comfortable | compact
  focus_mode        Boolean  @default(false) @map("focus_mode")
  reduce_motion     Boolean  @default(false) @map("reduce_motion")
  sidebar_collapsed Boolean  @default(false) @map("sidebar_collapsed")
  pause_character   Boolean  @default(false) @map("pause_character")
  room_view         Boolean  @default(false) @map("room_view")
  created_at        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("platform")
}

model Account {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @map("user_id") @db.Uuid
  account_id               String    @map("account_id")
  provider_id              String    @map("provider_id")
  provider_email           String?   @map("provider_email")
  provider_username        String?   @map("provider_username")
  access_token             String?   @map("access_token")
  refresh_token            String?   @map("refresh_token")
  access_token_expires_at  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                    String?   @map("scope")
  id_token                 String?   @map("id_token")
  password                 String?   @map("password")
  created_at               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider_id, account_id])
  @@index([user_id])
  @@map("accounts")
  @@schema("platform")
}

model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @map("user_id") @db.Uuid
  token               String    @unique @map("token")
  token_hash          String?   @unique @map("token_hash")
  active_workspace_id String?   @map("active_workspace_id") @db.Uuid
  fresh_until         DateTime? @map("fresh_until") @db.Timestamptz(6)
  expires_at          DateTime  @map("expires_at") @db.Timestamptz(6)
  revoked_at          DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip_address          String?   @map("ip_address")
  user_agent          String?   @map("user_agent")
  created_at          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([active_workspace_id])
  @@map("sessions")
  @@schema("platform")
}

model Verification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String    @map("identifier")
  value      String    @map("value")
  expires_at DateTime  @map("expires_at") @db.Timestamptz(6)
  created_at DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
  @@schema("platform")
}

model PlatformStaff {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @unique @map("user_id") @db.Uuid
  staff_role  String   @map("staff_role") // operator | platform_admin | support
  assigned_by String?  @map("assigned_by") @db.Uuid
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("platform_staff")
  @@schema("platform")
}

model AuthLoginAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier   String   @map("identifier")
  ip_address   String   @map("ip_address")
  success      Boolean  @map("success")
  attempted_at DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([ip_address])
  @@index([attempted_at])
  @@map("auth_login_attempts")
  @@schema("platform")
}

model SigningKey {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kid         String   @unique @map("kid") @db.VarChar(64)
  alg         String   @default("EdDSA") @map("alg") @db.VarChar(32)
  public_key  String   @map("public_key") @db.Text
  status      String   @default("active") @map("status") @db.VarChar(32) // active | next | retired
  purpose     String   @default("context") @map("purpose") @db.VarChar(32) // context | mcp_access_token
  valid_from  DateTime @default(now()) @map("valid_from") @db.Timestamptz(6)
  valid_until DateTime @map("valid_until") @db.Timestamptz(6)
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([purpose, status])
  @@map("signing_keys")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Agents & Operations (Carried over from Init)
// ---------------------------------------------------------------------------

model Conversation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String    @map("workspace_id") @db.Uuid
  user_id           String    @map("user_id") @db.Uuid
  kind              String    @default("hub") @map("kind") // hub | room
  agent_slug        String?   @map("agent_slug")
  title             String?   @map("title")
  title_source      String?   @map("title_source") // user | auto | first_message
  pinned_at         DateTime? @map("pinned_at") @db.Timestamptz(6)
  archived_at       DateTime? @map("archived_at") @db.Timestamptz(6)
  origin_message_id String?   @map("origin_message_id") @db.Uuid
  origin_channel    String?   @default("web") @map("origin_channel")
  last_message_at   DateTime? @map("last_message_at") @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages      Message[]
  chat_runs     ChatRun[]
  message_cards MessageCard[]

  @@index([workspace_id, user_id, last_message_at])
  @@index([workspace_id, kind])
  @@index([workspace_id, agent_slug])
  @@map("conversations")
  @@schema("platform")
}

model Message {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id   String   @map("conversation_id") @db.Uuid
  role              String   @map("role") // user | assistant | system
  agent_slug        String?  @map("agent_slug")
  content           String   @map("content") @db.Text
  mentions          Json?    @map("mentions")
  status            String   @default("completed") @map("status") // pending | completed | failed | needs_approval | needs_input | budget_exceeded | cancelled | error
  finish_reason     String?  @map("finish_reason")
  run_id            String?  @map("run_id")
  channel           String?  @default("web") @map("channel")
  client_message_id String?  @map("client_message_id")
  created_at        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation  Conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  chat_runs     ChatRun[]
  message_cards MessageCard[]

  @@index([conversation_id, created_at])
  @@index([conversation_id, client_message_id])
  @@index([run_id])
  @@map("messages")
  @@schema("platform")
}

// One streamed reply (ADR-0022). `run_handle` is the id the browser holds
// (allocated by POST .../messages); the upstream_* columns map it to sineva-ai.
model ChatRun {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String   @map("workspace_id") @db.Uuid
  conversation_id      String   @map("conversation_id") @db.Uuid
  user_message_id      String   @map("user_message_id") @db.Uuid
  run_handle           String   @unique @map("run_handle")
  agent_slug           String   @map("agent_slug")
  status               String   @default("pending") @map("status") // pending | streaming | completed | cancelled | error | needs_approval | needs_input | budget_exceeded | failed
  upstream_run_id      String?  @map("upstream_run_id")
  upstream_session_id  String?  @map("upstream_session_id")
  assistant_message_id String?  @map("assistant_message_id") @db.Uuid
  error_code           String?  @map("error_code")
  created_at           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user_message Message      @relation(fields: [user_message_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, conversation_id, created_at])
  @@map("chat_runs")
  @@schema("platform")
}

// A typed result card of an assistant message (ADR-0025, FR-AX-13). Written
// when the relay has validated `card_completed`; patches are never stored. A
// rejected card keeps only its code (`rejected_code`), `data` stays `{}`.
// `connection_id` and `approval_id` have no foreign key yet: their tables
// arrive with the connections and approvals work packages.
model MessageCard {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id        String    @map("message_id") @db.Uuid
  conversation_id   String    @map("conversation_id") @db.Uuid
  workspace_id      String    @map("workspace_id") @db.Uuid
  run_id            String?   @map("run_id")
  call_id           String?   @map("call_id")
  position          Int       @map("position")
  card_type         String    @map("card_type")
  schema_version    Int       @map("schema_version")
  state             String    @map("state") // drafting | ready | needs_review | done | failed | disconnected | cancelled | expired
  provider_slug     String?   @map("provider_slug")
  connection_id     String?   @map("connection_id") @db.Uuid
  approval_id       String?   @map("approval_id") @db.Uuid
  data              Json      @default("{}") @map("data")
  actions           Json      @default("[]") @map("actions")
  fallback_text     String?   @map("fallback_text") @db.Text
  payload_hash      String?   @map("payload_hash")
  validation_status String    @map("validation_status") // valid | rejected
  rejected_code     String?   @map("rejected_code")
  search_text       String?   @map("search_text") @db.Text
  version           Int       @default(1) @map("version")
  data_expires_at   DateTime? @map("data_expires_at") @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  message      Message      @relation(fields: [message_id], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([message_id, position])
  @@index([conversation_id, position])
  @@index([approval_id])
  @@index([workspace_id, conversation_id])
  @@map("message_cards")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Inbox, approvals and input requests (ADR-0032)
// ---------------------------------------------------------------------------

// One thing waiting on a person, or finished work. `approval` and
// `input_request` hang off it through their own unique `inbox_item_id`, so the
// link has a single source of truth. `recipient_user_id` has no foreign key on
// purpose: an item must outlive a removed member for the audit trail.
model InboxItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String    @map("workspace_id") @db.Uuid
  recipient_user_id String?   @map("recipient_user_id") @db.Uuid
  kind              String    @map("kind") // approval | input_request | result (handoff, system, idea come later)
  state             String    @default("open") @map("state") // open | resolved | dismissed | expired
  agent_slug        String?   @map("agent_slug")
  title             String    @map("title")
  summary_key       String    @map("summary_key")
  summary_params    Json      @default("{}") @map("summary_params")
  source_type       String    @map("source_type") // chat | room | system
  source_id         String?   @map("source_id")
  dedupe_key        String?   @map("dedupe_key")
  expires_at        DateTime? @map("expires_at") @db.Timestamptz(6)
  resolved_at       DateTime? @map("resolved_at") @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  reads         InboxItemRead[]
  approval      Approval?
  input_request InputRequest?

  @@unique([workspace_id, dedupe_key])
  @@index([workspace_id, kind, state, created_at])
  @@index([workspace_id, recipient_user_id, state])
  @@map("inbox_items")
  @@schema("platform")
}

model InboxItemRead {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inbox_item_id String   @map("inbox_item_id") @db.Uuid
  user_id       String   @map("user_id") @db.Uuid
  read_at       DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  item InboxItem @relation(fields: [inbox_item_id], references: [id], onDelete: Cascade)

  @@unique([inbox_item_id, user_id])
  @@index([user_id])
  @@map("inbox_item_reads")
  @@schema("platform")
}

// A proposed action with a structured payload. `status` is final once it
// leaves `pending`. `claimed_*` is an in-flight decision (the row is still
// pending while sineva-ai is told); `version` is the optimistic guard.
model Approval {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String    @map("workspace_id") @db.Uuid
  inbox_item_id        String    @unique @map("inbox_item_id") @db.Uuid
  agent_slug           String    @map("agent_slug")
  source_type          String    @map("source_type")
  source_id            String?   @map("source_id")
  run_id               String?   @map("run_id")
  upstream_approval_id String    @map("upstream_approval_id")
  action_type          String    @map("action_type")
  payload              Json      @map("payload")
  payload_hash         String    @map("payload_hash")
  risk_level           String    @map("risk_level") // low | medium | high
  requirement          String    @map("requirement") // guardrail | policy
  guardrail_reason     String?   @map("guardrail_reason")
  status               String    @default("pending") @map("status") // pending | approved | rejected | expired | cancelled
  revision             Int       @default(1) @map("revision")
  version              Int       @default(1) @map("version")
  awaiting_revision    Boolean   @default(false) @map("awaiting_revision")
  change_request       String?   @map("change_request") @db.Text
  claimed_by           String?   @map("claimed_by") @db.Uuid
  claimed_decision     String?   @map("claimed_decision") // approve | reject | changes
  claimed_at           DateTime? @map("claimed_at") @db.Timestamptz(6)
  decided_by           String?   @map("decided_by") @db.Uuid
  decided_at           DateTime? @map("decided_at") @db.Timestamptz(6)
  decision_note        String?   @map("decision_note") @db.Text
  resume_delivered_at  DateTime? @map("resume_delivered_at") @db.Timestamptz(6)
  expires_at           DateTime  @map("expires_at") @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  item      InboxItem          @relation(fields: [inbox_item_id], references: [id], onDelete: Cascade)
  revisions ApprovalRevision[]

  @@unique([workspace_id, upstream_approval_id])
  @@index([workspace_id, status, expires_at])
  @@index([status, expires_at])
  @@map("approvals")
  @@schema("platform")
}

// Immutable: a revision row is never updated, a new draft is a new row.
model ApprovalRevision {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_id        String   @map("approval_id") @db.Uuid
  revision           Int      @map("revision")
  payload            Json     @map("payload")
  payload_hash       String   @map("payload_hash")
  created_by         String   @map("created_by") // specialist | user
  created_by_user_id String?  @map("created_by_user_id") @db.Uuid
  note               String?  @map("note") @db.Text
  created_at         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  approval Approval @relation(fields: [approval_id], references: [id], onDelete: Cascade)

  @@unique([approval_id, revision])
  @@map("approval_revisions")
  @@schema("platform")
}

// A question a run is blocked on. `answer` is user content: it is stored here
// and sent to the run, and nowhere else.
model InputRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String    @map("workspace_id") @db.Uuid
  inbox_item_id       String    @unique @map("inbox_item_id") @db.Uuid
  agent_slug          String    @map("agent_slug")
  source_id           String?   @map("source_id")
  run_id              String?   @map("run_id")
  upstream_request_id String    @map("upstream_request_id")
  question            String    @map("question") @db.Text
  form_schema         Json      @map("form_schema")
  answer              Json?     @map("answer")
  status              String    @default("pending") @map("status") // pending | answered | dismissed | expired
  version             Int       @default(1) @map("version")
  claimed_by          String?   @map("claimed_by") @db.Uuid
  claimed_at          DateTime? @map("claimed_at") @db.Timestamptz(6)
  answered_by         String?   @map("answered_by") @db.Uuid
  answered_at         DateTime? @map("answered_at") @db.Timestamptz(6)
  resume_delivered_at DateTime? @map("resume_delivered_at") @db.Timestamptz(6)
  due_at              DateTime? @map("due_at") @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  item      InboxItem @relation(fields: [inbox_item_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, upstream_request_id])
  @@index([status, due_at])
  @@map("input_requests")
  @@schema("platform")
}

model StorageObject {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String   @db.Uuid
  object_key      String   @unique
  bucket_name     String
  file_name       String
  content_type    String
  file_size_bytes Int
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("storage_objects")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Sino Library (ADR-0030). Metadata only: parsing, chunks and vectors belong to
// sineva-ai. `created_by` carries no foreign key on purpose: a document belongs
// to the workspace, and removing a user must not remove what they uploaded.
// ---------------------------------------------------------------------------

// `parent_key` is the parent folder id, or the workspace id at the root. It
// exists because a unique index over a nullable `parent_id` does not stop two
// root folders with the same name (NULLs are distinct), so the unique index is
// built over a column that is never null. Folders are never cascade-deleted by
// a folder delete: the folder foreign keys are NO ACTION, which blocks deleting
// a folder that is still referenced but, unlike RESTRICT, is checked at the end
// of the statement, so deleting a whole workspace can still cascade through
// folders and documents together.
model LibraryFolder {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @map("workspace_id") @db.Uuid
  parent_id    String?  @map("parent_id") @db.Uuid
  parent_key   String   @map("parent_key") @db.Uuid
  name         String   @map("name")
  created_by   String?  @map("created_by") @db.Uuid
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  parent    LibraryFolder?       @relation("LibraryFolderTree", fields: [parent_id], references: [id], onDelete: NoAction)
  children  LibraryFolder[]      @relation("LibraryFolderTree")
  documents LibraryDocument[]
  scopes    LibraryFolderScope[]

  @@unique([workspace_id, parent_key, name])
  @@index([workspace_id, parent_id])
  @@map("library_folders")
  @@schema("platform")
}

// `uploaded_at` is null between the presign and `complete`: such a row is not a
// document yet (hidden from lists, not counted by quotas). `status` stays
// `queued` until sineva-ai reports otherwise; the platform never sets `ready`
// itself. `ingest_job_id` is chosen by the platform and sent to sineva-ai, so
// an event that races the accepting response still correlates;
// `last_ingest_sequence` makes event application a compare-and-set.
model LibraryDocument {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String    @map("workspace_id") @db.Uuid
  folder_id            String?   @map("folder_id") @db.Uuid
  title                String    @map("title")
  source_type          String    @map("source_type") // upload | url | crawl | sync | chat_save | note | ai_tool
  source_id            String?   @map("source_id") @db.Uuid
  storage_key          String?   @map("storage_key")
  mime_type            String    @map("mime_type")
  byte_size            Int       @map("byte_size")
  content_hash         String    @map("content_hash") @db.VarChar(64)
  language             String    @default("unknown") @map("language") // id | en | mixed | unknown
  status               String    @default("queued") @map("status") // queued | processing | ready | needs_attention | failed | deleting
  status_detail        Json?     @map("status_detail")
  page_count           Int?      @map("page_count")
  chunk_count          Int       @default(0) @map("chunk_count")
  ocr_page_count       Int       @default(0) @map("ocr_page_count")
  embedding_model      String?   @map("embedding_model")
  last_indexed_at      DateTime? @map("last_indexed_at") @db.Timestamptz(6)
  source_updated_at    DateTime? @map("source_updated_at") @db.Timestamptz(6)
  review_interval_days Int?      @map("review_interval_days")
  review_due_at        DateTime? @map("review_due_at") @db.Timestamptz(6)
  review_reminded_at   DateTime? @map("review_reminded_at") @db.Timestamptz(6)
  ingest_job_id        String?   @map("ingest_job_id") @db.Uuid
  ingest_attempted_at  DateTime? @map("ingest_attempted_at") @db.Timestamptz(6)
  last_ingest_sequence Int       @default(0) @map("last_ingest_sequence")
  acl_synced_at        DateTime? @map("acl_synced_at") @db.Timestamptz(6)
  // True while the document follows its collection's access (ADR-0033). The
  // default is false so existing documents keep the scopes they already have.
  access_inherited     Boolean   @default(false) @map("access_inherited")
  uploaded_at          DateTime? @map("uploaded_at") @db.Timestamptz(6)
  created_by           String    @map("created_by") @db.Uuid
  created_at           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace              @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  folder    LibraryFolder?         @relation(fields: [folder_id], references: [id], onDelete: NoAction)
  scopes    LibraryDocumentScope[]
  events    LibraryIngestEvent[]

  @@index([workspace_id, status])
  @@index([workspace_id, content_hash])
  @@index([workspace_id, folder_id])
  @@index([review_due_at])
  @@map("library_documents")
  @@schema("platform")
}

// `scope_ref` is never null so the unique index works: the workspace id for the
// workspace scope, the agent slug for a specialist, the squad id for a squad.
model LibraryDocumentScope {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id  String   @map("document_id") @db.Uuid
  workspace_id String   @map("workspace_id") @db.Uuid
  scope_type   String   @map("scope_type") // workspace | specialist | squad | workflow
  scope_ref    String   @map("scope_ref")
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document  LibraryDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([document_id, scope_type, scope_ref])
  @@index([workspace_id, scope_type, scope_ref])
  @@map("library_document_scopes")
  @@schema("platform")
}

// Who can use what is in a collection (ADR-0033): the same shape as a
// document's scopes, `workspace` meaning Everyone. A collection always has at
// least one row; the migration backfilled the existing ones with `workspace`.
model LibraryFolderScope {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folder_id    String   @map("folder_id") @db.Uuid
  workspace_id String   @map("workspace_id") @db.Uuid
  scope_type   String   @map("scope_type") // workspace | specialist | squad | workflow
  scope_ref    String   @map("scope_ref")
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  folder    LibraryFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, scope_type, scope_ref])
  @@index([workspace_id, scope_type, scope_ref])
  @@map("library_folder_scopes")
  @@schema("platform")
}

// Append-only: the repository has no update. `event_id` is the idempotency key
// of an event reported by sineva-ai (null for events the platform records
// itself); `applied` is false for an event that was stored but ignored because
// it was stale or the document was being deleted.
model LibraryIngestEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id  String   @map("document_id") @db.Uuid
  workspace_id String   @map("workspace_id") @db.Uuid
  event_id     String?  @map("event_id") @db.Uuid
  job_id       String?  @map("job_id") @db.Uuid
  sequence     Int?     @map("sequence")
  stage        String   @map("stage")
  outcome      String   @map("outcome")
  status       String?  @map("status")
  detail       Json?    @map("detail")
  applied      Boolean  @default(true) @map("applied")
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document  LibraryDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([document_id, event_id])
  @@index([document_id, created_at])
  @@map("library_ingest_events")
  @@schema("platform")
}

// Business Profile, onboarding and website scan (ADR-0031)
// ---------------------------------------------------------------------------

// One profile per workspace. A field counts as confirmed when `field_meta`
// holds an entry for it (source and `confirmed_at`); only confirmed values
// reach the profile pack. List-like fields are jsonb so "never set" (null)
// stays distinct from "set to an empty list". `updated_by` has no foreign key
// on purpose: authorship of a version must outlive the person's account.
model BusinessProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String    @unique @db.Uuid
  version        Int       @default(0)
  display_name   String?
  legal_name     String?
  industry       String?
  city           String?
  province       String?
  languages      Json?
  website_url    String?
  social_handles Json?
  business_hours Json?
  brand_voice    Json?
  audience       String?
  goals          Json?
  field_meta     Json      @default("{}")
  confirmed_at   DateTime? @db.Timestamptz(6)
  updated_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("business_profiles")
  @@schema("platform")
}

// Price is integer IDR (`bigint`, conventions section 2) and exists only when
// the user typed it (FR-ONB-16).
model BusinessOffering {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String    @db.Uuid
  name           String
  description    String?
  price_amount   BigInt?
  price_currency String    @default("IDR")
  url            String?
  position       Int
  source         String    @default("user") // user | scan
  confirmed_at   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, position])
  @@map("business_offerings")
  @@schema("platform")
}

model BusinessPolicy {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  kind         String // returns | shipping | payment | hours | faq | other
  title        String
  body         String    @db.Text
  source       String    @default("user") // user | scan
  confirmed_at DateTime? @db.Timestamptz(6)
  updated_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, kind])
  @@map("business_policies")
  @@schema("platform")
}

// Frozen copy of the profile, offers and policies after each save. Unique per
// workspace and version, which is also what makes two concurrent saves of the
// same base version fail instead of both succeeding.
model BusinessProfileVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String   @db.Uuid
  version       Int
  snapshot      Json
  changed_paths Json     @default("[]")
  change_kind   String // save | restore
  restored_from Int?
  changed_by    String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, version])
  @@map("business_profile_versions")
  @@schema("platform")
}

model OnboardingState {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String    @db.Uuid
  user_id         String    @db.Uuid
  flow            String    @default("owner") // owner | member
  status          String    @default("in_progress") // in_progress | completed | abandoned
  current_step    Int       @default(1)
  answers         Json      @default("{}")
  skipped_steps   Json      @default("[]")
  dismissed_tasks Json      @default("[]")
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([user_id])
  @@map("onboarding_states")
  @@schema("platform")
}

// One row per scan request. `deleted_at` is a soft delete on purpose: a
// deleted row still counts toward the 5 per hour quota, so deleting cannot
// reset the limit. `result` is the unconfirmed suggestion and is blanked after
// `expires_at` (24 hours).
model ProfileScan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  requested_by String    @db.Uuid
  url          String
  status       String    @default("running") // queued | running | partial | succeeded | failed
  result       Json?
  error_code   String?
  deleted_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, created_at(sort: Desc)])
  @@map("profile_scans")
  @@schema("platform")
}

model WorkspaceChecklistState {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @db.Uuid
  item_key     String
  status       String   @default("done") // done | dismissed
  source       String
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, item_key])
  @@map("workspace_checklist_state")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Audit log (append-only; FR-SEC-31, FR-SEC-32)
// ---------------------------------------------------------------------------

// No foreign key on `workspace_id` on purpose: audit rows must outlive the
// workspace they describe (whether workspace deletion removes them is
// OQ-SEC-9), and a cascade here would let a workspace delete rewrite history.
// The ingest endpoint and the use cases validate ids before writing.
// `prev_hash` and `hash` stay null until the per-workspace chain lands; the
// application only ever inserts and selects (the repository port has no
// update or delete). `actor_id` and `target_id` are text because they name
// non-uuid things too (a specialist slug, a signing key `kid`).
model AuditEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String?  @db.Uuid
  occurred_at          DateTime @default(now()) @db.Timestamptz(6)
  actor_type           String   @db.VarChar(32) // user | specialist | system | support | mcp_client
  actor_id             String
  on_behalf_of_user_id String?
  action               String   @db.VarChar(128)
  target_type          String?  @db.VarChar(64)
  target_id            String?
  outcome              String   @default("allowed") @db.VarChar(16) // allowed | denied | error
  reason_code          String?  @db.VarChar(128)
  request_id           String?
  run_id               String?
  ip                   String?  @db.VarChar(64)
  user_agent           String?  @db.VarChar(512)
  change               Json?
  metadata             Json?
  prev_hash            String?  @db.VarChar(64)
  hash                 String?  @db.VarChar(64)

  @@index([workspace_id, occurred_at(sort: Desc)])
  @@index([workspace_id, action, occurred_at(sort: Desc)])
  @@index([actor_id, occurred_at(sort: Desc)])
  @@index([request_id])
  @@index([run_id])
  @@map("audit_events")
  @@schema("platform")
}

// A Workflow (ADR-0045): the editable draft lives on this row, published
// versions are immutable rows in `workflow_versions`. `draft_revision` goes up
// on every edit: a stale writer gets a 409, and a test run only unlocks publish
// while its `draft_revision` still equals this one. `current_version_id` has no
// foreign key on purpose (the two tables would reference each other); the
// repository sets it inside the publish transaction. `created_by` is a plain
// id, not a relation, so deleting a user never deletes a procedure.
model Workflow {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String    @map("workspace_id") @db.Uuid
  name               String    @map("name")
  description        String?   @map("description")
  status             String    @default("draft") @map("status") // draft | published | archived
  draft_definition   Json      @map("draft_definition")
  draft_revision     Int       @default(1) @map("draft_revision")
  current_version_id String?   @map("current_version_id") @db.Uuid
  template_slug      String?   @map("template_slug")
  created_by         String    @map("created_by") @db.Uuid
  archived_at        DateTime? @map("archived_at") @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]
  runs      WorkflowRun[]

  @@index([workspace_id, status, updated_at(sort: Desc)])
  @@map("workflows")
  @@schema("platform")
}

// Immutable once written. A run pins its version, so these rows are never
// deleted while a run references them (NO ACTION on the run side, not
// RESTRICT: a workspace delete removes runs and workflows in one statement,
// and only the deferred NO ACTION check lets that through).
model WorkflowVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id    String   @map("workflow_id") @db.Uuid
  workspace_id   String   @map("workspace_id") @db.Uuid
  version_number Int      @map("version_number")
  definition     Json     @map("definition")
  schema_version Int      @map("schema_version")
  note           String?  @map("note")
  restored_from  Int?     @map("restored_from")
  published_by   String   @map("published_by") @db.Uuid
  published_at   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  workflow  Workflow      @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@unique([workflow_id, version_number])
  @@map("workflow_versions")
  @@schema("platform")
}

// Summary of a run; sineva-ai holds the authoritative state (ADR-0046).
// `definition` is the snapshot the run was started with, so a later edit never
// changes what a finished run shows. `engine_run_id` is the correlation id the
// platform sends to sineva-ai (a handle, not a database id), chosen before the
// call so an event that races the answer still finds the row. A test run of a
// draft has no `version_id`; `draft_revision` says which draft it tested.
model WorkflowRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String    @map("workspace_id") @db.Uuid
  workflow_id       String    @map("workflow_id") @db.Uuid
  version_id        String?   @map("version_id") @db.Uuid
  version_number    Int?      @map("version_number")
  draft_revision    Int?      @map("draft_revision")
  engine_run_id     String    @unique @map("engine_run_id")
  mode              String    @map("mode") // test | live
  status            String    @default("queued") @map("status") // queued | running | waiting | needs_review | succeeded | failed | cancelled | budget_exceeded
  started_by        String    @map("started_by") @db.Uuid
  trigger_type      String    @default("manual") @map("trigger_type") // manual | chat | routine | mcp
  routine_id        String?   @map("routine_id") @db.Uuid
  inputs            Json      @default("{}") @map("inputs")
  definition        Json      @map("definition")
  credits_estimated Int?      @map("credits_estimated")
  credits_used      Int       @default(0) @map("credits_used")
  error_code        String?   @map("error_code")
  last_event_seq    Int       @default(0) @map("last_event_seq")
  started_at        DateTime? @map("started_at") @db.Timestamptz(6)
  finished_at       DateTime? @map("finished_at") @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workflow  Workflow           @relation(fields: [workflow_id], references: [id], onDelete: NoAction)
  version   WorkflowVersion?   @relation(fields: [version_id], references: [id], onDelete: NoAction)
  steps     WorkflowRunStep[]
  events    WorkflowRunEvent[]

  @@index([workspace_id, created_at(sort: Desc)])
  @@index([workflow_id, created_at(sort: Desc)])
  @@index([workspace_id, status])
  @@map("workflow_runs")
  @@schema("platform")
}

// One row per step key of a run, moved by step events. `output_preview` and
// `trace` are read only with `workflow.trace.view`.
model WorkflowRunStep {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id           String    @map("run_id") @db.Uuid
  workspace_id     String    @map("workspace_id") @db.Uuid
  step_key         String    @map("step_key")
  position         Int       @map("position")
  step_type        String    @map("step_type")
  status           String    @map("status") // waiting | running | needs_review | done | failed | skipped
  attempt          Int       @default(1) @map("attempt")
  progress_current Int?      @map("progress_current")
  progress_total   Int?      @map("progress_total")
  output_preview   String?   @map("output_preview")
  trace            Json?     @map("trace")
  error_code       String?   @map("error_code")
  credits          Int       @default(0) @map("credits")
  approval_id      String?   @map("approval_id") @db.Uuid
  started_at       DateTime? @map("started_at") @db.Timestamptz(6)
  finished_at      DateTime? @map("finished_at") @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  run       WorkflowRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([run_id, step_key])
  @@map("workflow_run_steps")
  @@schema("platform")
}

// What sineva-ai said, applied or not: the history is the evidence when a run
// looks wrong, and the unique `event_id` makes a retried callback harmless.
model WorkflowRunEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id       String   @map("run_id") @db.Uuid
  workspace_id String   @map("workspace_id") @db.Uuid
  event_id     String   @map("event_id")
  sequence     Int      @map("sequence")
  type         String   @map("type") // run_status | step_started | step_completed
  applied      Boolean  @map("applied")
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run       WorkflowRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([run_id, event_id])
  @@map("workflow_run_events")
  @@schema("platform")
}
