# Application Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL
POSTGRES_USER=sineva_user
POSTGRES_PASSWORD=sineva_secret_password
POSTGRES_DB=sineva_platform
DATABASE_URL=postgresql://sineva_user:sineva_secret_password@localhost:5432/sineva_platform

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=sineva:platform:

# SeaweedFS S3 Object Storage
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sineva_s3_key
S3_SECRET_ACCESS_KEY=sineva_s3_secret
S3_BUCKET_NAME=sineva-assets
S3_FORCE_PATH_STYLE=true

# Internal AI Engine Gateway (Strictly internal network in Docker: http://sineva-ai:8000)
AI_ENGINE_INTERNAL_URL=http://sineva-ai:8000
AI_ENGINE_INTERNAL_API_KEY=sineva_internal_service_token_dev
# AI_ENGINE_INTERNAL_API_KEY_NEXT=
AI_ENGINE_TIMEOUT_MS=15000

# Authentication & Tenancy (Better Auth)
AUTH_SECRET=dev_insecure_auth_secret_placeholder_at_least_32_chars

# Signed Context (Ed25519 compact JWS)
INTERNAL_CONTEXT_SIGNING_KEY=dev_ed25519_signing_key_placeholder
INTERNAL_CONTEXT_KID=k1

# Transactional Email (WP-M0-24)
EMAIL_FROM=noreply@sineva.local
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
