# Application Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://sineva_user:sineva_secret_password@localhost:5432/sineva_platform

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=sineva:platform:

# SeaweedFS S3 Object Storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sineva_s3_key
S3_SECRET_ACCESS_KEY=sineva_s3_secret
S3_BUCKET_NAME=sineva-assets
S3_FORCE_PATH_STYLE=true

# Internal AI Engine Gateway (Strictly internal network in Docker: http://sineva-ai:8000)
AI_ENGINE_INTERNAL_URL=http://sineva-ai:8000
AI_ENGINE_INTERNAL_API_KEY=sineva_internal_service_token_dev
AI_ENGINE_TIMEOUT_MS=15000
