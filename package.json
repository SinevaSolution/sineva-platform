{
  "name": "sineva-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Sineva AI Platform Monorepo — Unified Web Platform & BFF Interface",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:reset": "node -e 'if (process.env.CONFIRM_RESET !== \"yes\") { console.error(\"Refusing to reset without CONFIRM_RESET=yes. This destroys all local volumes.\"); process.exit(1); }' && docker compose down -v",
    "runtime:check": "node scripts/check_node_runtime.mjs",
    "preinstall": "node scripts/check_node_runtime.mjs",
    "predev": "node scripts/check_node_runtime.mjs",
    "prebuild": "node scripts/check_node_runtime.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
